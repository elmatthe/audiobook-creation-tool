      "tts.pdf-without-text",
      "shutdown.tts-close-during-work",
      "shutdown.tts-close-forced-landing",
      "shutdown.converter-close-during-work",
      "shutdown.converter-close-forced-landing",
      "shutdown.mp3-close-during-work",
      "shutdown.mp3-close-forced-landing",
