      "converter.corrupt-source",
      "converter.cancel-during-encode",
      "maker.build-with-chapters-and-artwork",
      "maker.unreadable-track",
      "metadata.save-tags-then-clear",
      "metadata.confirmation-declined",
      "metadata.unreadable-file",
      "tts.edge-replay-direct-file",
      "tts.edge-replay-folder-mixed",
      "tts.service-failure-then-retry",
      "tts.cancel-during-narration",
