      "control.second-run-refused-by-the-lease",
      "control.other-desktop-is-blocked",
      "control.forced-landing-sees-the-crash",
      "control.act-orphan-seen-without-the-stop",
      "control.act-crash-seen-with-the-root-released",
      "launcher.six-tools-at-three-sizes",
