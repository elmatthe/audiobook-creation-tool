{
  "schema_version": 1,
  "about": "Execution policy of files/dev-work/verification-gate/verify.py: budgets, the frozen scenario names, what a skip may be, and what the routine gate does not yet cover. coverage.json holds the feature identities. A change here changes what PASS means, so this file is part of the policy digest of every run.",
  "stages": {
    "preflight": {
      "timeout_seconds": 120
    },
    "collect": {
      "timeout_seconds": 1500,
      "stall_seconds": 900
    },
    "pytest": {
      "timeout_seconds": 14400,
      "stall_seconds": 1500
    },
    "guarded": {
      "timeout_seconds": 5400,
      "stall_seconds": 1500
    },
    "acceptance": {
      "timeout_seconds": 2400,
      "stall_seconds": 420
    },
    "qualification": {
      "timeout_seconds": 28800,
      "stall_seconds": 3600
    }
  },
  "process": {
    "drain_seconds": 15,
    "kill_wait_seconds": 20
  },
  "scenarios": {
    "m4b-scaling": {
      "phase": 7,
      "network": [],
      "runner": "scaling/qualify.py",
      "detail": "M4B Converter split at scale against the frozen Phase 7A/7B budgets T1-T8 and T1b and the pinned per-build reference outputs (scaling/README.md); about three hours, never part of a routine mode"
    },
    "edge-low-memory": {
      "phase": 8,
      "network": [
        "online-edge"
      ],
      "runner": "qualification/edge_low_memory.py",
      "detail": "real Microsoft Edge speech through the real TTS panel: eight files in flight at once, a mixed folder with PDFs, Cancel during synthesis and during finalization, Pause then Cancel, and the queue under a real per-process memory limit (qualification/edge_low_memory.py); sends a few hundred short requests, so it runs only with --network online-edge and is BLOCKED without it"
    },
    "optional-engines": {
      "phase": 8,
      "network": [],
      "runner": "qualification/optional_engines.py",
      "detail": "bounded real synthesis, offline, on the Kokoro, Chatterbox Turbo and Qwen3-TTS already installed on this computer: two voices each, multi-chunk text, eight workers asked for and one used, the published MP3 decoded and measured (qualification/optional_engines.py); never downloads, a missing engine or model is BLOCKED"
    },
    "fresh-windows": {
      "phase": 8,
      "network": [
        "online-setup"
      ],
      "runner": "qualification/fresh_windows.py",
      "detail": "the committed application packaged by the real packager and audited, extracted fresh, set up by the real first-run base setup, launched, repaired offline after controlled damage, stopped during setup and completed offline from kept files, and failed cleanly offline with nothing to reuse (qualification/fresh_windows.py); downloads about 2.9 GB into the gate's scratch, so it runs only with --network online-setup and is BLOCKED without it; a fresh extraction on this Windows 11 account, not a new Windows installation"
    }
  },
  "later_phase_requirements": [],
  "coverage": {
    "about": "Since v0.7.2 Phase 4 the routine gate requires the reviewed inventory: schema 2, inventory_reviewed, every discovered surface mapped, every application source file reviewed as it is now. Required in full and changed runs.",
    "require_reviewed_inventory": true
  },
  "inventory": {
    "minimum_ordinary": 13000,
    "modules_without_tests": {
      "test_kokoro_voices.py": "a manual five-voice harness run as a script; it is named test_ but defines no pytest test"
    },
    "minimum_guarded": {
      "v3-planning": 450,
      "v3-supervisor": 70
    },
    "guarded_membership": {
      "v3-planning": [
        "test_optional_setup_exchange_v3.py",
        "test_optional_setup_confirmation_v3.py",
        "test_optional_setup_display_controller_v3.py",
        "test_optional_setup_planning_worker_v3.py",
        "test_optional_setup_readonly_context_v3.py",
        "test_optional_setup_tk_harness_v3.py",
        "test_spacy_consumer.py",
        "test_p05b_isolation.py"
      ],
      "v3-supervisor": [
        "test_optional_setup_supervisor_v3.py"
      ]
    }
  },
  "required_self_tests": [
    "files/tests/test_gate_scratch_exception.py",
    "files/tests/test_native_acceptance.py",
    "files/tests/test_real_media_acceptance.py",
    "files/tests/test_repository_contract.py",
    "files/tests/test_surface_discovery.py",
    "files/tests/test_verification_coverage.py",
    "files/tests/test_verification_gate_contract.py",
    "files/tests/test_verify_evidence.py",
    "files/tests/test_verify_guarded.py"
  ],
  "skip_policy": {
    "win32": [
      {
        "id": "native-macos-only",
        "pattern": "^(aqua geometry regression: native macOS metrics only|the aqua branch needs aqua)$",
        "max": 39
      },
      {
        "id": "no-symlink-privilege",
        "pattern": "^this (environment|account) (cannot create|may not create)",
        "max": 16
      },
      {
        "id": "case-insensitive-filesystem",
        "pattern": "^(this filesystem is case-insensitive, so the two names are one file|the Windows path layer is case-blind by definition)$",
        "max": 3
      },
      {
        "id": "local-fixture-absent",
        "pattern": "^(set JACK_RYAN_M4B_FOLDER to the Jack Ryan fixture folder to run|no local A4 listening folder|no local ordered export|files/runtime-data/ currently holds no colliding test basename)$",
        "max": 6
      },
      {
        "id": "empty-parameter-set",
        "pattern": "^got empty parameter set for ",
        "max": 1
      }
    ]
  },
  "focused": {
    "required_guards": [
      "files/tests/test_application_source_boundary.py"
    ]
  },
  "changed": {
    "always": [
      "files/tests/test_application_source_boundary.py",
      "files/tests/test_repository_contract.py",
      "files/tests/test_verification_coverage.py"
    ],
    "no_selection": [
      "files/plans/",
      "files/release-history/",
      "md-instructions/",
      "README.md",
      "AI-WORKSPACE.md",
      "REPO-STRUCTURE.md",
      "scripts/project-status.py"
    ],
    "routes": {
      "files/dev-work/verification-gate/": [
